using UnityEngine;
using UnityEngine.InputSystem;

public class DebugInputActions : MonoBehaviour
{
    void OnEnable()
    {
        InputSystem.onEvent += OnInputEvent;
    }

    void OnDisable()
    {
        InputSystem.onEvent -= OnInputEvent;
    }

    private void OnInputEvent(InputEventPtr eventPtr, InputDevice device)
    {
        // Фильтруем только события от контроллеров (XR-контроллеры, клавиатура, мышь)
        if (device is UnityEngine.InputSystem.XR.XRController ||
            device is Mouse ||
            device is Keyboard)
        {
            foreach (InputControl control in eventPtr.EnumerateControls())
            {
                if (control.IsPressed())
                {
                    Debug.Log($"Device: {device.displayName}, Control: {control.path}, Value: {control.ReadValueAsObject()}");
                }
            }
        }
    }
}
